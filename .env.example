# Required: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_with_your_key

# Use the exact text model ID available in your OpenAI API project.
# If your account exposes a Luna model, replace this with that exact API ID.
OPENAI_TEXT_MODEL=gpt-5-mini

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
PORT=3000
